#!/bin/sh
# Product entry point. This never installs a runtime merely by being invoked.
set -eu
openrtl_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
openrtl_python=${OPENRTL_PYTHON:-python3}
if ! "$openrtl_python" -I -S -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 2)' >/dev/null 2>&1; then
    if [ -n "${OPENRTL_PYTHON:-}" ]; then
        printf '%s\n' 'The explicitly selected OPENRTL_PYTHON is unavailable or older than 3.12. No replacement was installed.' >&2
        exit 2
    fi
    openrtl_python=$(/usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
        HOME="${HOME:-}" XDG_STATE_HOME="${XDG_STATE_HOME:-}" \
        /bin/sh "$openrtl_root/tools/bootstrap_runtime.sh" "$@") || exit 2
fi
exec "$openrtl_python" -I -S -B "$openrtl_root/tools/bootstrap_openrtl.py" "$@"
